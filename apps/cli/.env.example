# Copy to apps/cli/.env. ./ee runs Bun with apps/cli as its working directory, and Bun only
# loads .env from there, so a .env at the repo root isn't picked up.
GOOGLE_GENERATIVE_AI_API_KEY=
# Any Gemini model ID that accepts video. `ee video-analyze --model <id>` overrides it per call.
EE_GEMINI_MODEL=
