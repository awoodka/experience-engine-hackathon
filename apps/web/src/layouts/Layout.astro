---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    style="display: flex; flex-direction: column; height: 100dvh; margin: 0; overflow: hidden;"
  >
    <!-- Top navigation bar -->
    <nav
      style="
        display: flex;
        align-items: center;
        gap: 0.25rem;
        height: 48px;
        min-height: 48px;
        padding: 0 1.25rem;
        z-index: 10;
      "
    >
      <a
        href="/"
        style={`
          padding: 0.3rem 0.75rem;
          border-radius: 6px;
          text-decoration: none;
          font-size: 0.875rem;
          font-weight: 500;
          transition: background 0.15s;
          color: ${pathname === "/" ? "var(--color-ee-accent)" : "var(--color-ee-text-secondary)"};
          background: ${pathname === "/" ? "rgba(245,158,11,0.1)" : "transparent"};
        `}
      >
        Chat
      </a>
      <a
        href="/tutorials"
        style={`
          padding: 0.3rem 0.75rem;
          border-radius: 6px;
          text-decoration: none;
          font-size: 0.875rem;
          font-weight: 500;
          transition: background 0.15s;
          color: ${pathname.startsWith("/tutorials") ? "var(--color-ee-accent)" : "var(--color-ee-text-secondary)"};
          background: ${pathname.startsWith("/tutorials") ? "rgba(245,158,11,0.1)" : "transparent"};
        `}
      >
        Tutorials
      </a>
    </nav>

    <!-- Page content fills remaining height -->
    <div style="flex: 1; min-height: 0; overflow: hidden;">
      <slot />
    </div>
  </body>
</html>
