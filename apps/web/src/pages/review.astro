---
import Layout from "../layouts/Layout.astro";
import DailyReview from "../components/DailyReview";
---

<Layout title="Daily Review — Experience Engine">
  <DailyReview client:load />
</Layout>

<style is:global>
  /* ═══════════════════════════════════════════════
     REVIEW PAGE
     ═══════════════════════════════════════════════ */

  .rv-page {
    height: 100%;
    overflow-y: auto;
    background: var(--color-ee-bg);
    color: var(--color-ee-text);
    position: relative;
  }

  .rv-content {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin: 0 auto;
    padding: 2.5rem 2.5rem 5rem;
  }

  /* ── Hero header ── */

  .rv-hero {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin-bottom: 1.75rem;
    animation: rv-enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .rv-hero__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    flex-shrink: 0;
  }

  .rv-hero__date-month {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-ee-text-muted);
    letter-spacing: 0.04em;
  }

  .rv-hero__date-day {
    font-family: var(--font-display);
    font-size: 4.5rem;
    color: var(--color-ee-accent);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .rv-hero__body {
    flex: 1;
    padding-top: 0.15rem;
    min-width: 0;
  }

  .rv-hero__label {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ee-text-faint);
    display: block;
    margin-bottom: 0.3rem;
  }

  .rv-hero__name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
    letter-spacing: -0.025em;
    color: var(--color-ee-text);
  }

  .rv-hero__meta {
    font-size: 0.78rem;
    color: var(--color-ee-text-muted);
    margin: 0 0 1.25rem;
    line-height: 1.4;
  }

  /* ── Category meters ── */

  .rv-meters {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    animation: rv-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  .rv-meter {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .rv-meter__label {
    font-size: 0.58rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    width: 85px;
    text-align: right;
    flex-shrink: 0;
  }

  .rv-meter__track {
    flex: 1;
    max-width: 140px;
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
  }

  .rv-meter__fill {
    height: 100%;
    border-radius: 2px;
    animation: rv-meter-grow 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  @keyframes rv-meter-grow {
    from {
      width: 0 !important;
    }
  }

  .rv-meter__count {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    width: 1rem;
    flex-shrink: 0;
  }

  /* ── Summary ── */

  .rv-summary {
    border-left: 2px solid var(--color-ee-accent);
    padding: 0.75rem 1.15rem;
    margin-bottom: 2rem;
    background: rgba(245, 158, 11, 0.025);
    border-radius: 0 8px 8px 0;
    animation: rv-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  .rv-summary p {
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--color-ee-text-secondary);
    margin: 0;
  }

  /* ── Video grid ── */

  .rv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  /* ── Animations ── */

  @keyframes rv-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .rv-hero {
      flex-direction: column;
      gap: 1rem;
    }

    .rv-hero__date {
      flex-direction: row;
      gap: 0.5rem;
      align-items: baseline;
    }

    .rv-hero__date-day {
      font-size: 3rem;
    }

    .rv-content {
      padding: 1.5rem 1.25rem 4rem;
    }
  }
</style>
