---
import Layout from "../layouts/Layout.astro";
import TutorialGrid from "../components/TutorialGrid";
---

<Layout title="Tutorials — Experience Engine">
  <div class="tut-page">
    <div class="ee-glow ee-glow--warm" aria-hidden="true"></div>
    <div class="ee-glow ee-glow--deep" aria-hidden="true"></div>
    <div class="ee-grain" aria-hidden="true"></div>

    <div class="tut-container">
      <TutorialGrid client:load />
    </div>
  </div>
</Layout>

<style is:global>
  .tut-page {
    height: 100%;
    overflow-y: auto;
    background: var(--color-ee-bg);
    color: var(--color-ee-text);
    position: relative;
  }

  .tut-container {
    position: relative;
    z-index: 2;
    padding: 2.5rem 2.5rem 5rem;
    max-width: 1320px;
    margin: 0 auto;
  }

  /* ── Loading ── */

  .tut-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    height: 300px;
    color: var(--color-ee-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tut-loading__spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-ee-border);
    border-top-color: var(--color-ee-accent);
    border-radius: 50%;
    animation: tut-spin 0.7s linear infinite;
  }

  @keyframes tut-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Header ── */

  .tut-header {
    margin-bottom: 2.5rem;
    animation: tut-enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes tut-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tut-header__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--color-ee-text);
    margin: 0 0 0.15rem 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .tut-header__rule {
    width: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-ee-accent),
      rgba(245, 158, 11, 0.2)
    );
    border: none;
    border-radius: 1px;
    margin: 0.65rem 0 0.85rem;
    animation: tut-rule-draw 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  @keyframes tut-rule-draw {
    from {
      width: 0;
      opacity: 0;
    }
    to {
      width: 56px;
      opacity: 1;
    }
  }

  .tut-header__meta {
    color: var(--color-ee-text-muted);
    margin: 0 0 0.15rem 0;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .tut-header__count {
    color: var(--color-ee-text-faint);
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  /* ── Grid ── */

  .tut-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  /* ── Empty state ── */

  .tut-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    gap: 1.25rem;
    text-align: center;
    animation: tut-enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .tut-empty__icon {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: tut-empty-pulse 3s ease-in-out infinite;
  }

  @keyframes tut-empty-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
    }
    50% {
      box-shadow: 0 0 0 14px rgba(245, 158, 11, 0.04);
    }
  }

  .tut-empty__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-ee-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .tut-empty__desc {
    color: var(--color-ee-text-muted);
    max-width: 380px;
    line-height: 1.6;
    margin: 0;
    font-size: 0.88rem;
  }

  .tut-empty__cmd {
    background: rgba(245, 158, 11, 0.04);
    color: var(--color-ee-accent);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    border: 1px solid rgba(245, 158, 11, 0.12);
    letter-spacing: 0.01em;
  }

  .tut-empty__link {
    margin-top: 0.25rem;
    color: var(--color-ee-text-faint);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tut-empty__link:hover {
    color: var(--color-ee-accent);
  }

  /* ── Error ── */

  .tut-error {
    color: var(--color-ee-text-muted);
    text-align: center;
    padding: 5rem 0;
    font-size: 0.9rem;
    animation: tut-enter 0.5s ease-out both;
  }

  @media (max-width: 640px) {
    .tut-container {
      padding: 1.5rem 1.25rem 4rem;
    }

    .tut-header__title {
      font-size: 2rem;
    }

    .tut-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
