{
  "name": "experience-engine",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "prettier --write . && eslint --fix . && bun scripts/validate-tutorials.ts",
    "agent": "bun scripts/agent.ts",
    "ee": "bun --cwd apps/cli src/index.ts",
    "sync": "bun scripts/sync.ts sync",
    "upload": "bun scripts/sync.ts upload"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.10",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "ai": "^6.0.97"
  }
}
